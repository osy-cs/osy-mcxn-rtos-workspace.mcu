// FreeRTOS Section

// Task priorities.
#define LOW_TASK_PRIORITY           ( configMAX_PRIORITIES - 4 )
#define NORMAL_TASK_PRIORITY        ( configMAX_PRIORITIES - 3 )
#define HIGH_TASK_PRIORITY          ( configMAX_PRIORITIES - 1 )

#define TASK_NAME_LEFT_BUTTON       "left button"
#define TASK_NAME_RIGHT_BUTTON      "right button"
#define TASK_NAME_RED_LED           "red led"


// global variables
SemaphoreHandle_t g_sem_left_button;
SemaphoreHandle_t g_sem_right_button;

int32_t g_red_led_index = 0;


extern "C" {
void GPIO30_IRQHandler(void);
}

// ISR for GPIO3
void GPIO30_IRQHandler(void)
{
    // DO NOT USE return in this Interrupt Service Routine!!!

    // Get mask of all current interrupts
    uint32_t l_mask = GPIO_GpioGetInterruptFlags( pinname2gpio( P3_18 ) );

    TickType_t l_cur_tick = xTaskGetTickCount();
    static TickType_t l_left_last = 0;
    static TickType_t l_right_last = 0;

    // Button P3_18
    if ( ( l_mask & PIN_MASK( P3_18 ) ) != 0 )
    {
        if ( l_left_last + 20 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_left_button, nullptr );
            l_left_last = l_cur_tick;
        }
    }

    // Button P3_19
    if ( ( l_mask & PIN_MASK( P3_19 ) ) != 0 )
    {
    }

    // Button P3_20
    if ( ( l_mask & PIN_MASK( P3_20 ) ) != 0 )
    {
    }

    // Button P3_21
    if ( ( l_mask & PIN_MASK( P3_21 ) ) != 0 )
    {
        if ( l_right_last + 20 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_right_button, nullptr );
            l_right_last = l_cur_tick;
        }
    }

    // Clear interrupt flags
    GPIO_GpioClearInterruptFlags( pinname2gpio( P3_18 ),
            PIN_MASK( P3_18 ) | PIN_MASK( P3_19 ) | PIN_MASK( P3_20 ) | PIN_MASK( P3_21 ) | );
}

// Initialize GPIO for interrupts
void InitGPIOInterrupts()
{
    // Set correct priority
    NVIC_SetPriority( GPIO30_IRQn, configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY + 1 );

    // Enable interrupt for buttons
    // Available interrupt methods: kPORT_InterruptFallingEdge,kPORT_InterruptRisingEdge, kPORT_InterruptEitherEdge;
    GPIO_SetPinInterruptConfig( pinname2gpio( P3_18_GPIO ), pinname2pinnum( P3_18_PIN ), kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( pinname2gpio( P3_19_GPIO ), pinname2pinnum( P3_19_PIN ), kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( pinname2gpio( P3_20_GPIO ), pinname2pinnum( P3_20_PIN ), kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( pinname2gpio( P3_21_GPIO ), pinname2pinnum( P3_21_PIN ), kGPIO_InterruptFallingEdge );

    // Enable interrupt
    EnableIRQ( GPIO30_IRQn );

    // Create binary semaphores
    g_sem_left_button = xSemaphoreCreateBinary();
    //g_sem_in_left_button = xSemaphoreCreateBinary();
    //g_sem_in_right_button = xSemaphoreCreateBinary();
    g_sem_right_button = xSemaphoreCreateBinary();
}

// Tasks
void task_left_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_left_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_18.read() != 0 )
        {
            continue;
        }

        g_red_led_index--;
    }
}

void task_right_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_right_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_21.read() != 0 )
        {
            continue;
        }

        g_red_led_index++;

        vTaskDelay( 1 );
    }
}

void task_show_red_led( void *t_arg )
{
    int32_t l_last_index = -1;

    while ( 1 )
    {
        // check range of g_red_led_index
        if ( g_red_led_index >= RED_LED_NUM )
        {
            g_red_led_index = RED_LED_NUM - 1;
        }
        if ( g_red_led_index < 0 )
        {
            g_red_led_index = 0;
        }

        // position changed?
        if ( l_last_index != g_red_led_index )
        {
            if ( l_last_index < 0 )
            {
                l_last_index = g_red_led_index;
            }

            g_red_led[ l_last_index ].write( 0 );
            g_red_led[ g_red_led_index ].write( 1 );
            //GPIO_PinWrite( g_led_ptc[ l_last_index ].m_led_gpio, g_led_ptc[ l_last_index ].m_led_pin, 0 );
            //GPIO_PinWrite( g_led_ptc[ g_red_led_index ].m_led_gpio, g_led_ptc[ g_red_led_index ].m_led_pin, 1 );

            l_last_index = g_red_led_index;
        }

        vTaskDelay( 1 );
    }
}

void InitDemoApp()
{
    InitGPIOInterrupts();

    // Create tasks
    if ( xTaskCreate(
            task_left_button,
            TASK_NAME_LEFT_BUTTON,
            configMINIMAL_STACK_SIZE + 100,
            NULL,
            NORMAL_TASK_PRIORITY,
            NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_LEFT_BUTTON );
    }

    if ( xTaskCreate( task_right_button, TASK_NAME_RIGHT_BUTTON, configMINIMAL_STACK_SIZE + 100, NULL, HIGH_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_RIGHT_BUTTON );
    }

    if ( xTaskCreate( task_show_red_led, TASK_NAME_RED_LED, configMINIMAL_STACK_SIZE + 100, NULL, HIGH_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_RED_LED );
    }
}

