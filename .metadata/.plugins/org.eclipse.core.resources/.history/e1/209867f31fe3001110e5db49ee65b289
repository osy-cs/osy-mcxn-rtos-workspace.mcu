// P3   17      P3_17
//
// Red LED pin assignments:
//
// Port Pin     Pin Name
// ---------------------
// P4    0      P4_00
// P4    1      P4_01
// P4    2      P4_02
// P4    3      P4_00
// P4   12      P4_12
// P4   13      P4_13
// P4   16      P4_16
// P4   20      P4_20
//
// RGB LED pin assignments:
//
// Port Pin     Pin Name
// ---------------------_
// P0   14      P0_14    \.
// P0   15      P0_15     } RGB0
// P0   22      P0_22   _/
// P0   24      P0_24    \.
// P0   25      P0_25     } RGB1
// P0   26      P0_26   _/
// P0   28      P0_28    \.
// P0   29      P0_29     } RGB2
// P0   30      P0_30   _/


// **************************************************************************
//! Global Data Section

#define KIT_LED_NUM                 2
#define RED_LED_NUM                 8
#define RGB_LED_NUM                 9

//! Buttons on MCXN-KIT - instances of class DigitalIn
DigitalIn g_but_P3_18( P3_18 );
DigitalIn g_but_P3_19( P3_19 );
DigitalIn g_but_P3_20( P3_20 );
DigitalIn g_but_P3_21( P3_21 );

// all P3_xx LEDs in array
DigitalOut g_kit_led[ KIT_LED_NUM ] =
{
        P3_16,
        P3_17,
};

// all P4_xx LEDs in array
DigitalOut g_red_led[ RED_LED_NUM ] =
{
        P4_00,
        P4_01,
        P4_02,
        P4_03,
        P4_12,
        P4_13,
        P4_16,
        P4_20,
};

// **************************************************************************
// FreeRTOS Section

// Task priorities.
#define LOW_TASK_PRIORITY           ( configMAX_PRIORITIES - 4 )
#define NORMAL_TASK_PRIORITY        ( configMAX_PRIORITIES - 3 )
#define HIGH_TASK_PRIORITY          ( configMAX_PRIORITIES - 1 )

#define TASK_NAME_BUTTONS           "buttons"
#define TASK_NAME_KIT_LEDS          "kit_leds"
#define TASK_NAME_LED_SNAKE_L       "led_snake_l"
#define TASK_NAME_LED_SNAKE_R       "led_snake_r"


// This task blinks alternatively both P3_16/17 LEDs
void task_kit_led_blink( void *t_arg )
{
    uint32_t l_inx = 0;

    while ( 1 )
    {
        // turn LED on
        g_kit_led[ l_inx ].write( 1 );
        vTaskDelay( 200 );
        // turn LED off
        g_kit_led[ l_inx ].write( 0 );
        // next LED
        l_inx++;
        l_inx %= KIT_LED_NUM;
    }
}

// This task is snake animation from left side on red LEDs
void task_snake_left( void *t_arg )
{
    while ( 1 )
    {
        vTaskSuspend( 0 );

        for ( int inx = 0; inx < RED_LED_NUM; inx++ )
        {
            // turn LED on
            g_red_led[ inx ].write( 1 );
            vTaskDelay( 200 );
            // turn LED off
            g_red_led[ inx ].write( 0 );
        }
    }
}

// This task is snake animation from right side on red LEDs
void task_snake_right( void *t_arg )
{
    while ( 1 )
    {
        vTaskSuspend( 0 );

        for ( int inx = RED_LED_NUM - 1; inx >= 0; inx-- )
        {
            // turn LED on
            g_red_led[ inx ].write( 1 );
            vTaskDelay( 200 );
            // switch LED off
            g_red_led[ inx ].write( 0 );
        }
    }
}


// This task monitors switches and control others led_* tasks
void task_switches( void *t_arg )
{
    // Get task handles for task names
    TaskHandle_t l_handle_led_kit = xTaskGetHandle( TASK_NAME_KIT_LEDS );
    TaskHandle_t l_handle_led_snake_l = xTaskGetHandle( TASK_NAME_LED_SNAKE_L );
    TaskHandle_t l_handle_led_snake_r = xTaskGetHandle( TASK_NAME_LED_SNAKE_R );

    while ( 1 )
    {
        // test P3_18 button
        if ( g_but_P3_18.read() == 0 )
        {
            if ( l_handle_led_kit )
            {
                vTaskSuspend( l_handle_led_kit );
            }
        }

        // test P3_19 button
        if ( g_but_P3_19.read() == 0 )
        {
            if ( l_handle_led_kit )
            {
                vTaskResume( l_handle_led_kit );
            }
        }

        // test P2_20 button
        if ( g_but_P3_20.read() == 0 )
        {
            if ( l_handle_led_snake_l )
            {
                vTaskResume( l_handle_led_snake_l );
            }
        }

        // test P3_21 button
        if ( g_but_P3_21.read() == 0 )
        {
            if ( l_handle_led_snake_r )
            {
                vTaskResume( l_handle_led_snake_r );
            }
        }

        vTaskDelay( 1 );
    }
}


// Start application
int main(void)
{

    PRINTF( "FreeRTOS task demo program.\r\n" );
    PRINTF( "Buttons P3_18 and P3_19 will stop and run Kit LEDs blinking.\r\n" );
    PRINTF( "Buttons P3_20 and P3_21 will start snake on red LEDS from the left and right side.\r\n");

    int i = 2;
    i = (int[]){ 1, 2, 3 }[ 2 ];
    // Create tasks
    if ( xTaskCreate(
            task_kit_led_blink,
            TASK_NAME_KIT_LEDS,
            configMINIMAL_STACK_SIZE + 100,
            NULL,
            NORMAL_TASK_PRIORITY,
            NULL ) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_KIT_LEDS );
    }

    if ( xTaskCreate( task_snake_left, TASK_NAME_LED_SNAKE_L, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL ) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_LED_SNAKE_L );
    }

    if ( xTaskCreate( task_snake_right, TASK_NAME_LED_SNAKE_R, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL ) != pdPASS)
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_LED_SNAKE_R );
    }

    if ( xTaskCreate( task_switches, TASK_NAME_BUTTONS, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_BUTTONS );
    }

    vTaskStartScheduler();

    while ( 1 );

    return 0 ;
}

