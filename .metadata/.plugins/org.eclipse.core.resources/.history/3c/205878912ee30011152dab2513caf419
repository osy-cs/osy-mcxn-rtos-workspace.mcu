// Task priorities.
#define LOW_TASK_PRIORITY           ( configMAX_PRIORITIES - 4 )
#define NORMAL_TASK_PRIORITY        ( configMAX_PRIORITIES - 3 )
#define HIGH_TASK_PRIORITY          ( configMAX_PRIORITIES - 1 )

#define TASK_NAME_SNAKE_PWM         "snake pwm"
#define TASK_NAME_RGB_PWM           "rgb pwm"
#define TASK_NAME_RGB_SET           "rgb set"
#define TASK_NAME_LEFT_BUTTON       "left button"
#define TASK_NAME_INLEFT_BUTTON     "in left button"
#define TASK_NAME_INRIGHT_BUTTON    "in right button"
#define TASK_NAME_RIGHT_BUTTON      "right button"


// global variables
SemaphoreHandle_t g_sem_left_button;
SemaphoreHandle_t g_sem_in_left_button;
SemaphoreHandle_t g_sem_in_right_button;
SemaphoreHandle_t g_sem_right_button;

int32_t g_rgb_pwm_perc[ RGB_LED_NUM ] = { 0, 0, 0, 5, 5, 5, 0, 0, 0 };
int32_t g_rgb_pwm_run = 1;
int32_t g_rgb_pwm_inx = 0;

extern "C" {
void GPIO30_IRQHandler(void);
}

// ISR for GPIO3
void GPIO30_IRQHandler(void)
{
    // DO NOT USE return in this Interrupt Service Routine!!!

    // Get mask of all current interrupts
    uint32_t l_mask = GPIO_GpioGetInterruptFlags( pinname2gpio( P3_18 ) );

    TickType_t l_cur_tick = xTaskGetTickCount();
    static TickType_t l_left_last = 0;
    static TickType_t l_in_left_last = 0;
    static TickType_t l_in_right_last = 0;
    static TickType_t l_right_last = 0;

    // DO NOT USE return in this Interrupt Service Routine!!!

    // Button P3_18
    if ( ( l_mask & PIN_MASK( P3_18 ) ) != 0 )
    {
        if ( l_left_last + 10 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_left_button, nullptr );
            l_left_last = l_cur_tick;
        }
    }

    // Button P3_19
    if ( ( l_mask & PIN_MASK( P3_19 ) ) != 0 )
    {
        if ( l_in_left_last + 10 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_in_left_button, nullptr );
            l_in_left_last = l_cur_tick;
        }
    }

    // Button P3_20
    if ( ( l_mask & P3_20_MASK ) != 0 )
    {
        if ( l_in_right_last + 10 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_in_right_button, nullptr );
            l_in_right_last = l_cur_tick;
        }
    }

    // Button P3_21
    if ( ( l_mask & P3_21_MASK ) != 0 )
    {
        if ( l_right_last + 10 < l_cur_tick )
        {
            xSemaphoreGiveFromISR( g_sem_right_button, nullptr );
            l_right_last = l_cur_tick;
        }
    }

    // Clear interrupt flags
    GPIO_GpioClearInterruptFlags( P3_18_GPIO,
            P3_18_MASK | P3_19_MASK | P3_20_MASK | P3_21_MASK );
}

// Initialize GPIO for interrupts
void InitGPIOInterrupts()
{
    // Set correct priority
    NVIC_SetPriority( GPIO30_IRQn, configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY + 1 );

    // Enable interrupt for buttons
    // Available interrupt methods: kPORT_InterruptFallingEdge,kPORT_InterruptRisingEdge, kPORT_InterruptEitherEdge;
    GPIO_SetPinInterruptConfig( P3_18_GPIO, P3_18_PIN, kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( P3_19_GPIO, P3_19_PIN, kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( P3_20_GPIO, P3_20_PIN, kGPIO_InterruptFallingEdge );
    GPIO_SetPinInterruptConfig( P3_21_GPIO, P3_21_PIN, kGPIO_InterruptFallingEdge );

    // Enable interrupt
    EnableIRQ( GPIO30_IRQn );

    // Create binary semaphores
    g_sem_left_button = xSemaphoreCreateBinary();
    g_sem_in_left_button = xSemaphoreCreateBinary();
    g_sem_in_right_button = xSemaphoreCreateBinary();
    g_sem_right_button = xSemaphoreCreateBinary();
}

// Tasks
void task_left_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_left_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_18.read() != 0 )
        {
            continue;
        }

        g_rgb_pwm_run = !g_rgb_pwm_run;
    }
}

void task_in_left_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_in_left_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_19.read() != 0 )
        {
            continue;
        }

        g_rgb_pwm_inx = ( g_rgb_pwm_inx + 1 ) % RGB_LED_NUM;
    }
}

void task_in_right_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_in_right_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_20.read() != 0 )
        {
            continue;
        }

        g_rgb_pwm_perc[ g_rgb_pwm_inx ] -= 5;
        if ( g_rgb_pwm_perc[ g_rgb_pwm_inx ] < 0 )
        {
            g_rgb_pwm_perc[ g_rgb_pwm_inx ] = 0;
        }
    }
}

void task_right_button( void *t_arg )
{
    while ( 1 )
    {
        xSemaphoreTake( g_sem_right_button, portMAX_DELAY );
        vTaskDelay( 1 );
        if ( g_but_P3_21.read() != 0 )
        {
            continue;
        }

        g_rgb_pwm_perc[ g_rgb_pwm_inx ] += 5;
        if ( g_rgb_pwm_perc[ g_rgb_pwm_inx ] > 100 )
        {
            g_rgb_pwm_perc[ g_rgb_pwm_inx ] = 100;
        }
    }
}

#define T 20
#define T_PERC( PERC ) ( ( T * PERC ) / 100 )

void task_snake_pwm( void * t_arg )
{
    int32_t l_inx = 0;
    int32_t l_dir = 1;
    int32_t repeat = 5;

    TickType_t l_ticks = xTaskGetTickCount();

    for ( ;; )
    {
        for ( int32_t t = 0; t < T; t++ )
        {
            for ( int32_t led = 0; led < RED_LED_NUM; led++ )
            {
                if ( led != l_inx )
                {
                    if ( t == T_PERC( 5 ) )
                    {
                        g_red_led[ led ].write( 0 );
                        //GPIO_PinWrite( g_led_ptc[ led ].m_led_gpio, g_led_ptc[ led ].m_led_pin, 0 );
                    }
                }
                else
                {
                    if ( t == T_PERC( 30 ) )
                    {
                        g_red_led[ led ].write( 0 );
                        //GPIO_PinWrite( g_led_ptc[ led ].m_led_gpio, g_led_ptc[ led ].m_led_pin, 0 );
                    }
                }
            }

            vTaskDelayUntil( &l_ticks, 1 );
        }

        for ( uint32_t led = 0; led < RED_LED_NUM; led++ )
        {
            g_red_led[ led ].write( 1 );
            //GPIO_PinWrite( g_led_ptc[ led ].m_led_gpio, g_led_ptc[ led ].m_led_pin, 1 );
        }

        if ( ( l_dir > 0 && l_inx == 7 ) || ( l_inx == 0 && l_dir < 0 ) )
        {
            l_dir = -l_dir;
        }
        repeat--;
        if ( repeat == 0 )
        {
            l_inx += l_dir;
            repeat = 5;
        }
    }
}

void task_rgb_pwm( void * t_arg )
{
    TickType_t l_ticks = xTaskGetTickCount();
    TaskHandle_t l_task = xTaskGetHandle( TASK_NAME_RGB_SET );

    while ( 1 )
    {
        for ( int32_t led = 0; led < RGB_LED_NUM; led++ )
        {
            g_rgb_led[ led ].write( 0 );
            //GPIO_PinWrite( g_led_ptb[ led ].m_led_gpio, g_led_ptb[ led ].m_led_pin, 0 );
        }

        if ( g_rgb_pwm_run == 0 )
        {
            vTaskResume( l_task );
            vTaskSuspend( 0 );
        }

        for ( int32_t t = 0; t < T; t++ )
        {
            for ( int32_t led = 0; led < RGB_LED_NUM; led++ )
            {
                int32_t onoff = t < T_PERC( g_rgb_pwm_perc[ led ] );
                g_rgb_led[ led ].write( onoff );
                //GPIO_PinWrite( g_led_ptb[ led ].m_led_gpio, g_led_ptb[ led ].m_led_pin, onoff );
            }

            vTaskDelayUntil( &l_ticks, 1 );
        }
    }
}

void task_rgb_set( void * t_arg )
{
    TaskHandle_t l_task = xTaskGetHandle( TASK_NAME_RGB_PWM );
    int32_t l_inx_last = g_rgb_pwm_inx;
    int32_t odd_even = 1;

    while ( 1 )
    {
        g_rgb_led[ l_inx_last ].write( 0 );
        //GPIO_PinWrite( g_led_ptb[ l_inx_last ].m_led_gpio, g_led_ptb[ l_inx_last ].m_led_pin, 0 );

        if ( g_rgb_pwm_run != 0 )
        {
            vTaskResume( l_task );
            vTaskSuspend( 0 );
        }

        l_inx_last = g_rgb_pwm_inx;
        odd_even = !odd_even;

        for ( int t = 0; t < T; t++ )
        {
            int32_t onoff = t < T_PERC( g_rgb_pwm_perc[ l_inx_last ] );

            if ( g_rgb_pwm_perc[ l_inx_last ] == 0 && t == 0 )
            {
                onoff = odd_even;
            }

            g_rgb_led[ l_inx_last ].write( onoff );
            //GPIO_PinWrite( g_led_ptb[ l_inx_last ].m_led_gpio, g_led_ptb[ l_inx_last ].m_led_pin, onoff );

            vTaskDelay( 1 );
        }
    }
}

void InitDemoApp()
{
    InitGPIOInterrupts();

    // Create tasks
    if ( xTaskCreate(
            task_left_button,
            TASK_NAME_LEFT_BUTTON,
            configMINIMAL_STACK_SIZE + 100,
            NULL,
            NORMAL_TASK_PRIORITY,
            NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_LEFT_BUTTON );
    }

    if ( xTaskCreate( task_in_left_button, TASK_NAME_INLEFT_BUTTON, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_INLEFT_BUTTON );
    }

    if ( xTaskCreate( task_in_right_button, TASK_NAME_INRIGHT_BUTTON, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_INRIGHT_BUTTON );
    }

    if ( xTaskCreate( task_right_button, TASK_NAME_RIGHT_BUTTON, configMINIMAL_STACK_SIZE + 100, NULL, NORMAL_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_RIGHT_BUTTON );
    }

    if ( xTaskCreate( task_snake_pwm, TASK_NAME_SNAKE_PWM, configMINIMAL_STACK_SIZE + 100, NULL, HIGH_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_SNAKE_PWM );
    }

    if ( xTaskCreate( task_rgb_pwm, TASK_NAME_RGB_PWM, configMINIMAL_STACK_SIZE + 100, NULL, HIGH_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_RGB_PWM );
    }

    if ( xTaskCreate( task_rgb_set, TASK_NAME_RGB_SET, configMINIMAL_STACK_SIZE + 100, NULL, HIGH_TASK_PRIORITY, NULL) != pdPASS )
    {
        PRINTF( "Unable to create task '%s'!\r\n", TASK_NAME_RGB_SET );
    }

}

